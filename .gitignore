# Dados e Modelos (Segurança de IP)
data/raw/*.csv
data/processed/*.csv
models/*.joblib
models/*.pkl
models/*.h5

# Python
__pycache__/
src/__pycache__/
*.pyc
*.pyo
.venv/

# Environment & Secrets
.env
.env.*
# Mas versionar o .env.example (template)
!.env.example

# Jupyter
.ipynb_checkpoints/
*.py~

# Sistema e Logs
.DS_Store
Thumbs.db
.pytest_cache/
.coverage
*.log
pipeline.log

# Artefatos gerados (regeneraveis — nao versionar)
reports/*
data/raw/__pycache__/

# EDA e dicionario de colunas nao sao regeneraveis por script (gate CRISP-DM
# exige versionados — ver .claude/rules/dados.md na base)
!reports/eda_*.md
!reports/dicionario_*.md

# Screenshots e PDFs gerados na raiz
*.webp
*.png
[0-9]*.pdf

