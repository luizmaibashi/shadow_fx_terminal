# Shadow FX Terminal — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Chave da API Gemini (obrigatoria para Camada 3 — LLM-as-Judge)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Chave interna para autenticacao da API REST (opcional em dev)
# Se nao definida, a API roda sem autenticacao
API_KEY_INTERNA=

# Ativar julgamento via LLM na Camada 3 (true/false)
# Padrao: false — usa fallback heuristico
LLM_JUDGE_ENABLED=false
